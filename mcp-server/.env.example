# Copia este archivo a `.env` y ajusta si es necesario.
# Todas las variables tienen valores por defecto sensatos, así que .env es opcional.

# URL base de la API CKAN del Portal de Datos Abiertos de Chile
CHILEAN_DATA_API_URL=https://datos.gob.cl/api/3/action

# Timeout de las llamadas HTTP, en segundos
HTTP_API_TIMEOUT=30

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
